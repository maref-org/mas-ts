        "type": "object",
        "properties": {
          "server": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "input": {
            "type": "object"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object"
          },
          "is_error": {
            "type": "boolean"
          }
        }
      },
      "examples": [
        "server: 'filesystem', tool: 'read'"
      ],
      "rate_limit": "30/min",
      "business_rule_version": "2026-06-01"
    },
    {
      "skill_id": "constitution_enforcement",
      "description": "Constitution-based governance rules with remote verification and security redlines",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
