      "input_schema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "context": {
            "type": "object"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "response": {
            "type": "string"
          },
          "actions": {
            "type": "array"
