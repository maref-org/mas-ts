{
  "card_version": "2.0",
  "agent_id": "urn:agent:bytedance:trae-cn:trae-cn-1-0",
  "name": "Trae CN",
  "description": "ByteDance's AI-native IDE with built-in coding agent. Supports MCP protocol, custom skills system, constitution-based governance rules, and multi-agent coordination via .trae/ configuration. Deep integration with Chinese AI ecosystem (Doubao, Tongyi Qianwen).",
  "version": "1.0.0",
  "compliance": {
