  "capabilities": [
    {
      "skill_id": "bash",
      "description": "Execute shell commands with timeout and output capture",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "timeout": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "examples": [
        "command: 'npm test'"
      ],
      "rate_limit": "60/min",
      "business_rule_version": "2026-06-01",
      "sub_permissions": {
        "env_read": "bash can read environment variables (declared)",
        "timezone_read": "bash can read timezone info (declared)",
        "network_access": "bash can make network calls (declared)"
      }
    },
    {
      "skill_id": "file_read",
      "description": "Read file contents from local filesystem with offset/limit",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "lines": {
            "type": "integer"
          }
        }
      },
      "examples": [
        "path: '/src/main.ts'"
      ],
      "rate_limit": "120/min",
      "business_rule_version": "2026-06-01",
      "sub_permissions": {
        "system_files": "file_read can access /etc, /proc, /sys (declared)",
        "credential_files": "file_read can access ~/.ssh, ~/.aws (declared)"
      }
    },
    {
      "skill_id": "file_edit",
      "description": "Edit files using search/replace blocks",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "old_str": {
            "type": "string"
          },
          "new_str": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "diff": {
            "type": "string"
          }
        }
      },
      "examples": [
        "path: '/src/app.ts', old_str: 'foo()', new_str: 'bar()'"
      ],
      "rate_limit": "60/min",
      "business_rule_version": "2026-06-01",
      "sub_permissions": {
        "system_files": "file_edit can modify /etc, /proc, /sys (declared)",
        "credential_files": "file_edit can modify ~/.ssh, ~/.aws (declared)"
      }
    },
    {
      "skill_id": "mcp_tool",
      "description": "Call tools via Model Context Protocol with multiple transport types",
      "input_schema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "input": {
            "type": "object"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object"
          },
          "is_error": {
            "type": "boolean"
          }
        }
      },
      "examples": [
        "server: 'github', tool: 'create_issue'"
      ],
      "rate_limit": "30/min",
      "business_rule_version": "2026-06-01"
    },
    {
      "skill_id": "task_management",
      "description": "Create, update, list, and get persistent tasks",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "object"
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "examples": [
        "action: 'create', payload: {title: 'Implement auth'}"
      ],
      "rate_limit": "30/min",
      "business_rule_version": "2026-06-01"
    },
    {
      "skill_id": "subagent_dispatch",
      "description": "Launch sub-agents for parallel or nested task execution",
      "input_schema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "subagent_type": {
            "type": "string"
          }
