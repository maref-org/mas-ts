      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "examples": [
        "task: 'search codebase', subagent_type: 'explore'"
      ],
      "rate_limit": "5/min",
      "business_rule_version": "2026-06-01"
    },
    {
      "skill_id": "skill_invoke",
      "description": "Invoke SKILL.md-based skills for specialized workflows",
      "input_schema": {
        "type": "object",
        "properties": {
          "skill_name": {
            "type": "string"
          },
          "context": {
            "type": "object"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "examples": [
        "skill_name: 'debug'"
      ],
      "rate_limit": "10/min",
      "business_rule_version": "2026-06-01"
    }
