      "rate_limit": "5/min",
      "business_rule_version": "2026-05-01"
    },
    {
      "skill_id": "mcp_tool",
      "description": "Call tools via Model Context Protocol with multiple transport types",
      "input_schema": {"type": "object", "properties": {"server": {"type": "string"}, "tool": {"type": "string"}, "input": {"type": "object"}}},
      "output_schema": {"type": "object", "properties": {"result": {"type": "object"}, "is_error": {"type": "boolean"}}},
      "examples": ["server: 'github', tool: 'create_issue', input: {title: 'Bug'}"],
      "rate_limit": "30/min",
      "business_rule_version": "2026-04-15"
    },
    {
      "skill_id": "todo_write",
      "description": "Create and manage structured task lists for tracking progress",
      "input_schema": {"type": "object", "properties": {"todos": {"type": "array"}}},
      "output_schema": {"type": "object", "properties": {"success": {"type": "boolean"}}},
      "examples": ["todos: [{content: 'Fix bug', status: 'in_progress'}]"],
      "rate_limit": "30/min",
      "business_rule_version": "2026-05-01"
    },
    {
      "skill_id": "plan_mode",
      "description": "Enter/exit plan mode for read-only analysis before implementation",
      "input_schema": {"type": "object", "properties": {"action": {"type": "string", "enum": ["enter", "exit"]}}},
      "output_schema": {"type": "object", "properties": {"mode": {"type": "string"}}},
      "examples": ["action: 'enter'", "action: 'exit'"],
      "rate_limit": "10/min",
      "business_rule_version": "2026-05-01"
    },
    {
      "skill_id": "task_management",
      "description": "Create, update, list, and get persistent tasks with lifecycle management",
      "input_schema": {"type": "object", "properties": {"action": {"type": "string"}, "task_id": {"type": "string"}, "payload": {"type": "object"}}},
      "output_schema": {"type": "object", "properties": {"task": {"type": "object"}, "success": {"type": "boolean"}}},
      "examples": ["action: 'create', payload: {title: 'Implement auth'}"],
      "rate_limit": "30/min",
      "business_rule_version": "2026-05-01"
    },
    {
      "skill_id": "worktree",
      "description": "Create isolated git worktree sessions for parallel development",
      "input_schema": {"type": "object", "properties": {"action": {"type": "string", "enum": ["enter", "exit"]}, "branch": {"type": "string"}}},
      "output_schema": {"type": "object", "properties": {"worktree_path": {"type": "string"}, "success": {"type": "boolean"}}},
      "examples": ["action: 'enter', branch: 'feature/auth'"],
      "rate_limit": "5/min",
      "business_rule_version": "2026-05-01"
    },
    {
      "skill_id": "notebook_edit",
      "description": "Edit Jupyter notebook cells",
      "input_schema": {"type": "object", "properties": {"path": {"type": "string"}, "cell_number": {"type": "integer"}, "content": {"type": "string"}}},
      "output_schema": {"type": "object", "properties": {"success": {"type": "boolean"}}},
      "examples": ["path: '/analysis.ipynb', cell_number: 3"],
      "rate_limit": "30/min",
      "business_rule_version": "2026-04-15"
    },
    {
      "skill_id": "lsp",
      "description": "Language Server Protocol integration for code intelligence",
      "input_schema": {"type": "object", "properties": {"action": {"type": "string"}, "file": {"type": "string"}}},
      "output_schema": {"type": "object", "properties": {"diagnostics": {"type": "array"}, "definitions": {"type": "array"}}},
      "examples": ["action: 'diagnostics', file: '/src/app.ts'"],
      "rate_limit": "30/min",
      "business_rule_version": "2026-04-15"
    },
    {
      "skill_id": "cron",
      "description": "Create and manage cron-based scheduled recurring tasks",
      "input_schema": {"type": "object", "properties": {"action": {"type": "string"}, "cron_expression": {"type": "string"}, "message": {"type": "string"}}},
      "output_schema": {"type": "object", "properties": {"task_id": {"type": "string"}, "success": {"type": "boolean"}}},
      "examples": ["action: 'create', cron_expression: '0 8 * * *'"],
      "rate_limit": "5/min",
      "business_rule_version": "2026-05-01"
    },
    {
      "skill_id": "memory",
      "description": "File-based typed memory system with MEMORY.md entrypoint and topic files",
      "input_schema": {"type": "object", "properties": {"action": {"type": "string", "enum": ["read", "write", "search"]}, "topic": {"type": "string"}, "type": {"type": "string"}}},
      "output_schema": {"type": "object", "properties": {"content": {"type": "string"}, "entries": {"type": "array"}}},
      "examples": ["action: 'read', topic: 'project'", "action: 'write', type: 'feedback'"],
      "rate_limit": "60/min",
      "business_rule_version": "2026-05-01"
    },
    {
      "skill_id": "bridge",
      "description": "Remote control bridge for multi-session management with JWT auth",
      "input_schema": {"type": "object", "properties": {"action": {"type": "string"}, "session_id": {"type": "string"}, "config": {"type": "object"}}},
      "output_schema": {"type": "object", "properties": {"session": {"type": "object"}, "success": {"type": "boolean"}}},
      "examples": ["action: 'create_session', config: {mode: 'worktree'}"],
      "rate_limit": "10/min",
      "business_rule_version": "2026-05-01"
    },
    {
      "skill_id": "skill_invoke",
      "description": "Invoke bundled skills (batch, debug, loop, stuck, verify)",
      "input_schema": {"type": "object", "properties": {"skill_name": {"type": "string"}, "context": {"type": "object"}}},
      "output_schema": {"type": "object", "properties": {"result": {"type": "string"}, "success": {"type": "boolean"}}},
      "examples": ["skill_name: 'debug'", "skill_name: 'verify'"],
      "rate_limit": "10/min",
      "business_rule_version": "2026-05-01"
    }
  ],
  "endpoints": {
    "a2a": "https://api.anthropic.com/v1/agents",
    "mcp": "https://api.anthropic.com/v1/mcp"
  },
  "authentication": {
    "type": "APIKey",
    "scopes": ["code:read", "code:write", "bash:execute", "web:search", "agent:spawn"]
  },
  "dependencies": [
    "anthropic-api",
    "git",
    "nodejs",
    "typescript",
    "ripgrep",
    "mcp-protocol"
  ],
  "orchestration_hints": {
    "preferred_role": "supervisor",
    "parallel_safe": true,
    "stateful": true
  }
}
