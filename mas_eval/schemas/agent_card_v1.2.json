{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MAS-TS-001 Agent Card v1.2",
  "description": "Agent Card schema for MAS-TS-001 v3.0 — extends v1.1 with Constitution, message format, and governance fields",
  "type": "object",
  "required": [
    "card_version",
    "agent_id",
    "name",
    "version",
    "compliance",
    "constitution",
    "model_backend",
    "capabilities",
    "authentication"
  ],
  "properties": {
    "card_version": {
      "type": "string",
      "const": "1.2",
      "description": "Must be 1.2 per MAS-TS-001 v3.0"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^urn:agent:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9_-]+$",
      "description": "URN-format agent identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+",
      "description": "Semantic versioning"
    },
    "compliance": {
      "type": "object",
      "required": [
        "data_residency",
        "data_classification",
        "cross_border",
        "model_backend_location",
        "audit_trail_required"
      ],
      "properties": {
        "data_residency": {
          "type": "string",
          "enum": ["CN", "US", "EU", "SG", "OTHER", "LOCAL"],
          "description": "Physical data storage region"
        },
        "data_classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "cross_border": {
          "type": "boolean",
          "description": "Whether data crosses borders"
        },
        "model_backend_location": {
          "type": "string",
          "enum": ["CN", "US", "EU", "SG", "OTHER", "LOCAL"],
          "description": "Physical deployment location of LLM backend"
        },
        "audit_trail_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "constitution": {
      "type": "object",
      "description": "Constitution compliance fields (Article 15-A, 27, 28)",
      "required": [
        "envelope",
        "health_state",
        "heartbeat_interval_seconds"
      ],
      "properties": {
        "envelope": {
          "type": "object",
          "description": "Message envelope fields per Article 15-A",
          "required": [
            "message_id",
            "correlation_id",
            "timestamp",
            "sender"
          ],
          "properties": {
            "message_id": {
              "type": "string",
              "description": "Unique message identifier (UUID or ULID)"
            },
            "correlation_id": {
              "type": "string",
              "description": "Correlation ID for tracing message chains"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 timestamp of message creation"
            },
            "sender": {
              "type": "string",
              "description": "Sender agent ID"
            },
            "protocol": {
              "type": "string",
              "enum": ["json-rpc-2.0", "a2a-v0.3", "mcp-2024"],
              "description": "Optional: communication protocol identifier"
            }
          },
          "additionalProperties": false
        },
        "health_state": {
          "type": "string",
          "enum": ["STARTING", "HEALTHY", "DEGRADED", "DEAD"],
          "description": "Agent health state per Article 27 — 4-state lifecycle"
        },
        "heartbeat_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "Heartbeat interval in seconds per Article 28"
        },
        "stale_node_timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "description": "Timeout after which a non-responding node is considered stale"
        },
        "message_format": {
          "type": "object",
          "description": "Message format audit requirements",
          "properties": {
            "version": {
              "type": "string",
              "description": "Message format version"
            },
            "supported_transports": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["stdio", "sse", "websocket", "http", "grpc", "ipc"]
              },
              "description": "Supported transport protocols"
            },
            "max_payload_bytes": {
              "type": "integer",
              "minimum": 1024,
              "description": "Maximum message payload size in bytes"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "model_backend": {
      "type": "object",
      "required": ["provider", "model", "deployment", "endpoint"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "type": "string",
          "enum": ["local", "cloud", "hybrid"]
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["skill_id", "description", "input_schema", "output_schema", "examples"],
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rate_limit": {
            "type": "string"
          },
          "business_rule_version": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date format YYYY-MM-DD for prompt rot detection"
          },
          "sub_permissions": {
            "type": "object",
            "description": "v0.8.0 D1.14: Sub-permission declaration for high-risk capabilities (bash, file_read, file_edit, etc.). Keys are sub-permission names; values are human-readable descriptions.",
            "additionalProperties": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "a2a": {
          "type": "string",
          "format": "uri"
        },
        "mcp": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "authentication": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["OAuth2", "APIKey", "mTLS", "None"]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "description": "Governance state machine configuration for D4 assessment",
      "properties": {
        "state_machine_version": {
          "type": "string",
          "description": "Version of the state machine implementation"
        },
        "circuit_breaker_enabled": {
          "type": "boolean",
          "description": "Whether circuit breaker pattern is enabled"
        },
        "circuit_breaker_threshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Consecutive failures before circuit opens"
        },
        "cooldown_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Cooldown period in half-open state"
        },
        "oscillation_detection_enabled": {
          "type": "boolean",
          "description": "Whether oscillation detection is enabled"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "orchestration_hints": {
      "type": "object",
      "properties": {
        "preferred_role": {
          "type": "string",
          "enum": ["planner", "worker", "supervisor", "validator"]
        },
        "parallel_safe": {
          "type": "boolean"
        },
        "stateful": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
