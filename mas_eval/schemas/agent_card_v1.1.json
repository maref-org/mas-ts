{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MAS-TS-001 Agent Card v1.1",
  "description": "Agent Card schema for MAS-TS-001 standard compliance validation",
  "type": "object",
  "required": [
    "card_version",
    "agent_id",
    "name",
    "version",
    "compliance",
    "model_backend",
    "capabilities",
    "authentication"
  ],
  "properties": {
    "card_version": {
      "type": "string",
      "const": "1.1",
      "description": "Must be 1.1 per MAS-TS-001 v2.1"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^urn:agent:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9_-]+$",
      "description": "URN-format agent identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+",
      "description": "Semantic versioning"
    },
    "compliance": {
      "type": "object",
      "required": [
        "data_residency",
        "data_classification",
        "cross_border",
        "model_backend_location",
        "audit_trail_required"
      ],
      "properties": {
        "data_residency": {
          "type": "string",
          "enum": ["CN", "US", "EU", "SG", "OTHER", "LOCAL"],
          "description": "Physical data storage region"
        },
        "data_classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "cross_border": {
          "type": "boolean",
          "description": "Whether data crosses borders"
        },
        "model_backend_location": {
          "type": "string",
          "enum": ["CN", "US", "EU", "SG", "OTHER", "LOCAL"],
          "description": "Physical deployment location of LLM backend"
        },
        "audit_trail_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "model_backend": {
      "type": "object",
      "required": ["provider", "model", "deployment", "endpoint"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "type": "string",
          "enum": ["local", "cloud", "hybrid"]
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["skill_id", "description", "input_schema", "output_schema", "examples"],
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rate_limit": {
            "type": "string"
          },
          "business_rule_version": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date format YYYY-MM-DD for prompt rot detection"
          }
        },
        "additionalProperties": false
      }
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "a2a": {
          "type": "string",
          "format": "uri"
        },
        "mcp": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "authentication": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["OAuth2", "APIKey", "mTLS", "None"]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "orchestration_hints": {
      "type": "object",
      "properties": {
        "preferred_role": {
          "type": "string",
          "enum": ["planner", "worker", "supervisor", "validator"]
        },
        "parallel_safe": {
          "type": "boolean"
        },
        "stateful": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
